{
  "name": "content-hub",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm build:functions && astro build",
    "build:functions": "node scripts/build-functions.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:design": "node scripts/check-design.mjs",
    "arch": "depcruise src tests --config .dependency-cruiser.cjs",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run tests/unit --coverage",
    "e2e": "playwright test",
    "perf": "node scripts/perf-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/infrastructure/db/migrate-cli.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "probe:jira": "node --env-file=.env scripts/probe-jira.mjs",
    "sync:jira": "tsx --env-file=.env src/infrastructure/jira/sync-cli.ts",
    "compare:jira": "tsx --env-file=.env src/infrastructure/jira/compare-sample-cli.ts"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.12",
    "@electric-sql/pglite": "^0.5.16",
    "astro": "^7.4.9",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
