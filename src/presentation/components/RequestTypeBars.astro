---
import type { RequestTypeCount } from '@domain/jira/executive-summary';
import { formatNumber } from '../format-number';

interface Props {
  items: readonly RequestTypeCount[];
  /** Rows shown; the rest are added up in "Otros". */
  limit?: number;
}

const { items, limit = 6 } = Astro.props;

const shown = items.slice(0, limit);
const rest = items.slice(limit).reduce((sum, item) => sum + item.count, 0);
const rows = rest > 0 ? [...shown, { requestType: 'Otros', count: rest }] : shown;
const top = Math.max(1, ...rows.map((row) => row.count));
---

{rows.length === 0 ? (
  <p class="empty">Todavía no hay tickets creados en este trimestre.</p>
) : (
  <ul class="bar-list">
    {rows.map((row) => (
      <li class="bar-row">
        <span class="bar-name">{row.requestType}</span>
        <svg class="bar-track" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
          <rect
            class="bar bar-created"
            x="0"
            y="0"
            width={(row.count / top) * 100}
            height="8"
            rx="2"
          ></rect>
        </svg>
        <span class="bar-count">{formatNumber(row.count)}</span>
      </li>
    ))}
  </ul>
)}
