---
import type { SupportedTimeZone } from '@domain/access/time-zone';
import type { BreachRow } from '@domain/jira/sla-breaches';
import { formatMomentPlain, formatSpan, zoneLabel } from '../format-moment';
import { METRIC_LABEL } from '../sla-labels';
import TicketLink from './TicketLink.astro';

interface Props {
  rows: readonly BreachRow[];
  ticketUrlOf: (key: string) => string | null;
  timeZone: SupportedTimeZone;
  /** False for a continuation of a table that already showed its heading. */
  withHead?: boolean;
}

const { rows, ticketUrlOf, timeZone, withHead = true } = Astro.props;

function endedText(row: BreachRow): string {
  if (row.endedAt) return formatMomentPlain(row.endedAt, timeZone);
  return row.ticketClosed ? 'Ticket cerrado, reloj sin detener' : 'Sigue corriendo';
}
---

<table class="data-table">
  {withHead && (
    <thead>
      <tr>
        <th scope="col">Ticket</th>
        <th scope="col">Resumen</th>
        <th scope="col">Métrica</th>
        <th scope="col">Tipo</th>
        <th scope="col">Asignado a</th>
        <th scope="col">Límite ({zoneLabel(timeZone)})</th>
        <th scope="col">Terminó</th>
        <th scope="col">Retraso</th>
      </tr>
    </thead>
  )}
  <tbody>
    {rows.map((row) => (
      <tr>
        <th scope="row" data-label="Ticket" class="task-key">
          <TicketLink ticketKey={row.ticketKey} url={ticketUrlOf(row.ticketKey)} />
        </th>
        <td data-label="Resumen">{row.summary}</td>
        <td data-label="Métrica">{METRIC_LABEL[row.metric]}</td>
        <td data-label="Tipo">{row.requestType}</td>
        <td data-label="Asignado a">{row.assigneeName ?? 'Sin asignar'}</td>
        <td data-label="Límite">
          {row.breachAt ? formatMomentPlain(row.breachAt, timeZone) : '—'}
        </td>
        <td data-label="Terminó">{endedText(row)}</td>
        <td data-label="Retraso">
          <span class="verdict verdict-bad">
            {row.overdueMs === null ? '—' : formatSpan(row.overdueMs)}
          </span>
        </td>
      </tr>
    ))}
  </tbody>
</table>
