---
import type { MetricCompliance } from '@domain/jira/sla-compliance';
import { SLA_TARGET_PERCENT } from '@domain/jira/sla-compliance';
import { formatNumber, formatPercent } from '../format-number';
import InfoTip from './InfoTip.astro';

interface Props {
  metric: MetricCompliance;
  label: string;
  tip: string;
}

const { metric, label, tip } = Astro.props;
const rate = metric.ratePercent ?? 0;
const verdict =
  metric.meetsTarget === null
    ? 'Sin datos'
    : metric.meetsTarget
      ? '✔ Cumple la meta'
      : '✖ No cumple la meta';
const verdictClass =
  metric.meetsTarget === null
    ? 'verdict'
    : metric.meetsTarget
      ? 'verdict verdict-ok'
      : 'verdict verdict-bad';
---

<article class="sla-meter">
  <h3 class="kpi-label">
    {label}
    <InfoTip text={tip} label={label} />
  </h3>
  <p class="kpi-value">{formatPercent(metric.ratePercent)}</p>
  <svg
    class="meter"
    viewBox="0 0 100 10"
    preserveAspectRatio="none"
    role="img"
    aria-label={`${label}: ${formatPercent(metric.ratePercent)}. Meta ${String(SLA_TARGET_PERCENT)} %.`}
  >
    <rect class="meter-track" x="0" y="2" width="100" height="6" rx="3"></rect>
    <rect
      class={metric.meetsTarget === false ? 'meter-fill meter-fill-bad' : 'meter-fill'}
      x="0"
      y="2"
      width={rate}
      height="6"
      rx="3"
    ></rect>
    <line class="meter-goal" x1={SLA_TARGET_PERCENT} x2={SLA_TARGET_PERCENT} y1="0" y2="10"></line>
  </svg>
  <p class={verdictClass}>
    {verdict} · meta {SLA_TARGET_PERCENT} %
  </p>
  <p class="kpi-change">
    {formatNumber(metric.met)} cumplidos de {formatNumber(metric.total)} medidos
  </p>
</article>
