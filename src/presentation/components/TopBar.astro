---
import type { SyncStatus } from '@application/use-cases/jira/get-sync-status';
import type { SupportedTimeZone } from '@domain/access/time-zone';
import { formatMoment } from '../format-moment';
import Icon from './Icon.astro';
import StatusChip from './StatusChip.astro';

interface Props {
  /** The state of the Jira data. Pages that do not show it leave this out. */
  sync?:
    | {
        status: SyncStatus;
        timeZone: SupportedTimeZone;
        /** The person may press the button. When false, nothing about it is rendered. */
        canSync: boolean;
        csrfToken: string;
        /** Page to come back to after pressing the button. */
        back: string;
      }
    | undefined;
}

const { sync } = Astro.props;
---

<header class="topbar">
  <button
    class="icon-btn topbar-menu"
    type="button"
    popovertarget="site-nav"
    aria-label="Abrir el menú"
  >
    <Icon name="menu" />
  </button>
  <a class="topbar-brand" href="/">
    Content Hub
  </a>

  {sync && (
    <div class="sync-info">
      <div class="sync-stamp">
        {sync.status.lastUpdateAt ? (
          <>
            <span class="sync-stamp-label">Datos al</span>
            <span class="sync-stamp-time">
              {formatMoment(sync.status.lastUpdateAt, sync.timeZone)}
            </span>
          </>
        ) : (
          <span class="sync-stamp-label">Todavía no hay datos de Jira.</span>
        )}
      </div>
      {sync.status.running && <StatusChip kind="info" label="Actualizando…" icon="refresh" />}
      {sync.canSync && (
        <form method="post" action="/api/sync">
          <input type="hidden" name="_csrf" value={sync.csrfToken} />
          <input type="hidden" name="back" value={sync.back} />
          <button class="btn btn-secondary btn-compact sync-button" type="submit">
            <Icon name="refresh" size={16} />
            <span class="sync-button-text">Resincronizar con Jira</span>
          </button>
        </form>
      )}
    </div>
  )}
</header>
