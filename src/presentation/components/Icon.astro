---
import { ICONS, type IconName } from '../icons';

interface Props {
  name: IconName;
  /** 20 for navigation and actions, 16 inside chips and tables (DESIGN.md §5). */
  size?: 16 | 20 | 24;
  /** Set only when the icon says something the text next to it does not. Decorative otherwise. */
  label?: string | undefined;
  /** An extra class, e.g. `flip` to turn an arrow around. */
  class?: string | undefined;
}

const { name, size = 20, label, class: extra } = Astro.props;
---

<svg
  class={extra ? `icon ${extra}` : 'icon'}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {ICONS[name].map((d) => (
    <path d={d} />
  ))}
</svg>
