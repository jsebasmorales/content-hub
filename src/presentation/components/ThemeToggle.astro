---
import type { IconName } from '../icons';
import type { ThemeChoice } from '../theme';
import Icon from './Icon.astro';

interface Props {
  current: ThemeChoice;
  csrfToken: string;
  /** Page to come back to, with its filters. */
  back: string;
}

const { current, csrfToken, back } = Astro.props;

const choices: { value: ThemeChoice; icon: IconName; label: string }[] = [
  { value: 'light', icon: 'sun', label: 'Tema claro' },
  { value: 'system', icon: 'monitor', label: 'Tema del dispositivo' },
  { value: 'dark', icon: 'moon', label: 'Tema oscuro' },
];
---

<form class="theme-toggle" method="post" action="/api/theme" aria-label="Tema">
  <input type="hidden" name="_csrf" value={csrfToken} />
  <input type="hidden" name="back" value={back} />
  {choices.map((choice) => (
    <button
      class={`theme-option ${current === choice.value ? 'theme-option-on' : ''}`}
      type="submit"
      name="theme"
      value={choice.value}
      aria-pressed={current === choice.value ? 'true' : 'false'}
      aria-label={choice.label}
      title={choice.label}
    >
      <Icon name={choice.icon} />
    </button>
  ))}
</form>
