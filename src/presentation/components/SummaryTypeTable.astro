---
import type { TypeSummary } from '@domain/jira/summary-report';
import { formatNumber, formatPercent } from '../format-number';

interface Props {
  rows: readonly TypeSummary[];
}

const { rows } = Astro.props;
---

<div class="table-scroll">
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col">Tipo de solicitud</th>
        <th scope="col">Creados</th>
        <th scope="col">Completados</th>
        <th scope="col">% completadas</th>
        <th scope="col">Abiertos hoy</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row" data-label="Tipo de solicitud">
            {row.requestType}
          </th>
          <td data-label="Creados">{formatNumber(row.created)}</td>
          <td data-label="Completados">{formatNumber(row.resolved)}</td>
          <td data-label="% completadas">{formatPercent(row.completionPercent)}</td>
          <td data-label="Abiertos hoy">{formatNumber(row.openNow)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
