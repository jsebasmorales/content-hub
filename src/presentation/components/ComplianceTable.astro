---
import { SLA_METRICS } from '@domain/jira/sla';
import { SLA_TARGET_PERCENT, type SlaCompliance } from '@domain/jira/sla-compliance';
import { formatNumber, formatPercent } from '../format-number';
import { METRIC_LABEL } from '../sla-labels';
import StatusChip from './StatusChip.astro';

interface Row {
  label: string;
  compliance: SlaCompliance;
}

interface Props {
  /** Heading of the first column: "Mes", "Tipo de solicitud". */
  firstColumn: string;
  rows: readonly Row[];
}

const { firstColumn, rows } = Astro.props;
---

{rows.length === 0 ? (
  <p class="empty">No hay ciclos medidos en este periodo.</p>
) : (
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">{firstColumn}</th>
          {SLA_METRICS.map((metric) => (
            <th scope="col">
              {METRIC_LABEL[metric]} (meta {SLA_TARGET_PERCENT} %)
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row" data-label={firstColumn}>
              {row.label}
            </th>
            {row.compliance.metrics.map((metric) => {
              return (
                <td data-label={METRIC_LABEL[metric.metric]}>
                  {metric.meetsTarget === null ? (
                    formatPercent(metric.ratePercent)
                  ) : (
                    <StatusChip
                      kind={metric.meetsTarget ? 'success' : 'error'}
                      label={formatPercent(metric.ratePercent)}
                      hint={metric.meetsTarget ? 'cumple la meta' : 'no cumple la meta'}
                    />
                  )}
                  {metric.total > 0 && (
                    <span class="cell-note">
                      {formatNumber(metric.met)} de {formatNumber(metric.total)}
                    </span>
                  )}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
