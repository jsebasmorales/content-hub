---
import type { PersonLoad } from '@domain/jira/capacity';
import { BALANCE_CHIP } from '../balance';
import { formatNumber } from '../format-number';
import StatusChip from './StatusChip.astro';

interface Props {
  people: readonly PersonLoad[];
  average: number;
}

const { people, average } = Astro.props;

const scale = Math.max(1, average, ...people.map((person) => person.load));
const averageAt = (average / scale) * 100;
---

<ul class="bar-list">
  {people.map((person) => (
    <li class="bar-row">
      <div class="bar-line">
        <span class="bar-name">{person.name}</span>
        <span class="bar-meta">
          <StatusChip
            kind={BALANCE_CHIP[person.balance].kind}
            icon={BALANCE_CHIP[person.balance].icon}
            label={BALANCE_CHIP[person.balance].label}
          />
          <span class="bar-count">{formatNumber(person.load)}</span>
        </span>
      </div>
      <svg class="bar-track" width="100%" height="12" aria-hidden="true">
        <rect class="bar-track-rail" x="0" y="0" width="100%" height="12" rx="6"></rect>
        <rect
          class={`bar-track-fill bar-load-${person.balance}`}
          x="0"
          y="0"
          width={`${String((person.load / scale) * 100)}%`}
          height="12"
          rx="6"
        ></rect>
        <line
          class="load-average"
          x1={`${String(averageAt)}%`}
          x2={`${String(averageAt)}%`}
          y1="-2"
          y2="14"
        ></line>
      </svg>
    </li>
  ))}
</ul>
