---
import type { IconName } from '../icons';
import Icon from './Icon.astro';

interface Props {
  title: string;
  /** One line of help. */
  help: string;
  icon?: IconName;
}

const { title, help, icon = 'info' } = Astro.props;
---

<div class="empty-state">
  <Icon name={icon} size={24} />
  <p class="empty-state-title">{title}</p>
  <p>{help}</p>
  <slot />
</div>
