---
import { getApp, getJiraApp } from '@infrastructure/container';
import ChartCard from '../components/ChartCard.astro';
import ComplianceChart from '../components/ComplianceChart.astro';
import ComplianceTable from '../components/ComplianceTable.astro';
import DataTable from '../components/DataTable.astro';
import EmptyState from '../components/EmptyState.astro';
import GlobalFilters from '../components/GlobalFilters.astro';
import OngoingTable from '../components/OngoingTable.astro';
import PageHeader from '../components/PageHeader.astro';
import SlaCard from '../components/SlaCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { clearFilterCookie, filterQuery, readFilterRequest, settleFilter } from '../filter-request';
import { formatNumber } from '../format-number';
import { bucketLabel, describeWindow, granularityNoun } from '../period-labels';
import { METRIC_LABEL, METRIC_TIP } from '../sla-labels';
import { splitForPhone } from '../phone-split';
import { syncFlashFromQuery } from '../sync-messages';

const ONGOING_SHOWN = 30;

const principal = Astro.locals.principal;
if (!principal) return new Response(null, { status: 404 });

const secure = (await getApp()).settings.secureCookies;
const request = readFilterRequest(Astro.url, Astro.cookies, secure);
if (request.reset) {
  clearFilterCookie(Astro.cookies, secure);
  return Astro.redirect(Astro.url.pathname, 303);
}

const jira = await getJiraApp();
// Opening the page refreshes stale data in the background; it never waits for Jira.
await jira.requestSync.lazy();

const [status, result] = await Promise.all([
  jira.syncStatus.execute(),
  jira.slaReport.execute(principal.permissions, request.raw),
]);
if (!result.ok) return new Response(null, { status: 404 });
const { now, panel, report, granularity } = result.value;

const tidy = settleFilter(Astro.url, Astro.cookies, secure, request, panel.filter);
if (tidy) return Astro.redirect(tidy, 303);

const timeZone = principal.user.timeZone;

const periodLabel = describeWindow(panel.filter.window);
const goalText = {
  true: 'Las dos métricas cumplen la meta en este período.',
  false: 'Alguna métrica no llega a la meta en este período.',
  null: 'No hay ciclos medidos en este período.',
} as const;
const bucketRows = report.byBucket.map((entry) => ({
  label: bucketLabel(entry.bucket, granularity),
  compliance: entry.compliance,
}));
const typeRows = report.byRequestType.map((row) => ({
  label: row.requestType,
  compliance: row.compliance,
}));
const ongoing = report.ongoing.slice(0, ONGOING_SHOWN);
// On a phone only the most urgent show at first; the rest wait behind "Ver más".
const { first: firstRows, more: moreRows } = splitForPhone(ongoing);
const canSeeBreaches = principal.permissions.has('section.breach');
const query = filterQuery(panel.filter);
---

<BaseLayout
  title="SLAs"
  sync={{ status, flash: syncFlashFromQuery(Astro.url.searchParams) }}
  filterQuery={query}
>
  <div class="page">
    <PageHeader
      title="SLAs"
      lede="Cumplimiento de cada métrica contra la meta del 90 %, calculado por Jira y contado por el Hub."
    />

    <GlobalFilters action="/sla" panel={panel} />

    <section class="section" aria-labelledby="sla-goal-title">
      <div class="section-head">
        <h2 id="sla-goal-title">Cumplimiento en {periodLabel}</h2>
        <p>{goalText[String(report.overall.goalMet) as 'true' | 'false' | 'null']}</p>
      </div>
      <div class="kpi-grid kpi-grid-2">
        {report.overall.metrics.map((metric) => (
          <SlaCard
            metric={metric}
            label={METRIC_LABEL[metric.metric]}
            tip={METRIC_TIP[metric.metric]}
          />
        ))}
      </div>
    </section>

    <ChartCard
      title={`Cumplimiento, ${granularityNoun(granularity)}`}
      subtitle="Porcentaje de ciclos que cumplen la meta, por métrica."
    >
      {bucketRows.length === 0 ? (
        <EmptyState
          icon="clock"
          title="Sin ciclos medidos"
          help="No hay ciclos medidos en este período."
        />
      ) : (
        <>
          <ComplianceChart
            items={bucketRows}
            title={`Cumplimiento de SLA ${granularityNoun(granularity)}`}
            idPrefix="sla-monthly"
          />
          <details class="more">
            <summary>Ver los números de cada barra</summary>
            <ComplianceTable firstColumn="Período" rows={bucketRows} />
          </details>
        </>
      )}
    </ChartCard>

    <section class="section" aria-labelledby="by-type-title">
      <div class="section-head">
        <h2 id="by-type-title">Por tipo de solicitud</h2>
        <p>
          De más a menos ciclos medidos. Un tipo con pocos ciclos puede cambiar mucho con un solo
          incumplimiento.
        </p>
      </div>
      <DataTable label="Cumplimiento por tipo de solicitud">
        <ComplianceTable firstColumn="Tipo de solicitud" rows={typeRows} />
      </DataTable>
    </section>

    <section class="section" aria-labelledby="ongoing-title">
      <div class="section-head">
        <h2 id="ongoing-title">Ciclos en curso ahora</h2>
        <p>
          Relojes que siguen corriendo en tickets abiertos, del que vence antes al que vence
          después, sin importar el período elegido (sí se filtran por tipo de solicitud). Los
          vencidos ya cuentan como incumplidos.
          {report.pausedCount > 0 &&
            ` ${formatNumber(report.pausedCount)} ciclos en pausa no se muestran: su reloj está detenido.`}
          {report.closedWithOpenClockCount > 0 && (
            <>
              {' '}
              Otros {formatNumber(report.closedWithOpenClockCount)} ciclos siguen abiertos en
              tickets ya cerrados: Jira no los detuvo (por ejemplo, porque nunca hubo un comentario
              al cliente) y no se pueden accionar, así que no se listan aquí. Siguen contando en el
              cumplimiento.
              {canSeeBreaches && (
                <>
                  {' '}
                  Los que ya están vencidos aparecen, marcados, en{' '}
                  <a href={`/incumplimientos${query}`}>SLAs incumplidos</a>.
                </>
              )}
            </>
          )}
        </p>
      </div>
      {ongoing.length === 0 ? (
        <div class="card">
          <EmptyState
            icon="clock"
            title="Nada corriendo ahora"
            help="No hay ciclos corriendo ahora mismo en tickets abiertos."
          />
        </div>
      ) : (
        <DataTable
          label="Ciclos en curso"
          footnote={
            report.ongoing.length > ONGOING_SHOWN
              ? `Se muestran los ${String(ONGOING_SHOWN)} más urgentes de ${formatNumber(report.ongoing.length)}.`
              : undefined
          }
        >
          <div class="only-wide">
            <OngoingTable
              rows={ongoing}
              ticketUrlOf={jira.ticketUrl}
              timeZone={timeZone}
              now={now}
            />
          </div>
          <div class="only-narrow">
            <OngoingTable
              rows={firstRows}
              ticketUrlOf={jira.ticketUrl}
              timeZone={timeZone}
              now={now}
            />
            {moreRows.length > 0 && (
              <details class="more-rows">
                <summary>Ver más ({moreRows.length})</summary>
                <OngoingTable
                  rows={moreRows}
                  ticketUrlOf={jira.ticketUrl}
                  timeZone={timeZone}
                  now={now}
                  withHead={false}
                />
              </details>
            )}
          </div>
        </DataTable>
      )}
    </section>
  </div>
</BaseLayout>
