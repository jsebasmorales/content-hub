---
import { getJiraApp } from '@infrastructure/container';
import { BALANCE_TOLERANCE, PACE_MONTHS } from '@domain/jira/capacity';
import { NO_FILTER, OPEN_STATUS, UNASSIGNED } from '@domain/jira/task-list';
import ChartCard from '../components/ChartCard.astro';
import DataTable from '../components/DataTable.astro';
import EmptyState from '../components/EmptyState.astro';
import KpiCard from '../components/KpiCard.astro';
import LoadBars from '../components/LoadBars.astro';
import PageHeader from '../components/PageHeader.astro';
import PersonTable from '../components/PersonTable.astro';
import VolumeChart from '../components/VolumeChart.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Delta } from '../format-number';
import { formatNumber, monthShortName } from '../format-number';
import { splitForPhone } from '../phone-split';
import { syncFlashFromQuery } from '../sync-messages';
import { tasksHref } from '../tasks-query';

const principal = Astro.locals.principal;
if (!principal) return new Response(null, { status: 404 });

const jira = await getJiraApp();
// Opening the page refreshes stale data in the background; it never waits for Jira.
await jira.requestSync.lazy();

const [status, result] = await Promise.all([
  jira.syncStatus.execute(),
  jira.capacity.execute(principal.permissions),
]);
if (!result.ok) return new Response(null, { status: 404 });
const report = result.value;
const { flow } = report;

const phone = splitForPhone(report.people);
const outsideOpen = report.outside.reduce((sum, person) => sum + person.open, 0);
// The tasks list is a page of its own: the link exists only for people who may open it.
const canSeeTasks = principal.permissions.has('section.work');

const perMonth = (value: number | null): string =>
  value === null ? 'Sin datos' : formatNumber(value);
const difference = flow.difference;
const differenceText =
  difference === null
    ? 'Sin datos'
    : difference === 0
      ? '0'
      : `${difference > 0 ? '+' : '−'}${formatNumber(Math.abs(difference))}`;
// More coming in than going out is bad news for the queue; the arrow and the words say so too.
const differenceDelta: Delta | undefined =
  difference === null
    ? undefined
    : difference > 0
      ? { direction: 'up', tone: 'bad', text: 'Entra más de lo que sale: la cola crece' }
      : difference < 0
        ? { direction: 'down', tone: 'good', text: 'Sale más de lo que entra: la cola baja' }
        : { direction: 'flat', tone: 'neutral', text: 'Entra y sale lo mismo' };
const unassignedHref = tasksHref({ ...NO_FILTER, assigneeId: UNASSIGNED, status: OPEN_STATUS }, 1);
const tolerancePercent = Math.round(BALANCE_TOLERANCE * 100);
---

<BaseLayout title="Capacidad" sync={{ status, flash: syncFlashFromQuery(Astro.url.searchParams) }}>
  <div class="page">
    <PageHeader
      title="Capacidad"
      lede="Cómo se reparte el trabajo abierto entre el equipo y si entra más de lo que sale. Hoy la carga se mide en número de tareas."
    />

    <section class="section" aria-labelledby="flow-title">
      <div class="section-head">
        <h2 id="flow-title">Entrada y salida de trabajo</h2>
        <p>
          Promedio mensual de los últimos {PACE_MONTHS} meses completos, con las tareas del equipo y
          las que nadie tiene asignadas.
        </p>
      </div>
      <div class="kpi-grid kpi-grid-3">
        <KpiCard
          label="Cola actual"
          value={formatNumber(flow.openNow)}
          tip="Todas las tareas que todavía no están en Hecho, tengan o no responsable."
        />
        <KpiCard
          label="Entran por mes"
          value={perMonth(flow.arrivedPerMonth)}
          tip="Tareas nuevas creadas por mes, en promedio, durante los últimos meses completos."
        />
        <KpiCard
          label="Salen por mes"
          value={perMonth(flow.finishedPerMonth)}
          tip="Tareas que pasaron a Hecho por mes, en promedio, durante los últimos meses completos."
        />
        <KpiCard
          label="Diferencia por mes"
          value={differenceText}
          delta={differenceDelta}
          tip="Lo que entra menos lo que sale. Si es positivo y se mantiene, la cola crece cada mes."
        />
        <KpiCard
          label="Meses para vaciar la cola"
          value={flow.monthsToClear === null ? 'Sin datos' : formatNumber(flow.monthsToClear)}
          tip="Cola actual dividida entre lo que sale por mes, suponiendo que no entrara nada nuevo. Es una referencia, no una predicción."
        />
        <KpiCard
          label="Sin responsable"
          value={formatNumber(report.unassignedOpen)}
          tip="Tareas abiertas que nadie tiene asignadas. No entran en el promedio por persona."
        />
      </div>
      {report.unassignedOpen > 0 && canSeeTasks && (
        <p class="section-link">
          <a href={unassignedHref}>
            Ver las {formatNumber(report.unassignedOpen)} tareas abiertas sin responsable
          </a>
        </p>
      )}
    </section>

    <ChartCard
      title="Entrada y salida, últimos 6 meses"
      subtitle="Tickets creados frente a tickets resueltos cada mes."
    >
      <VolumeChart
        items={report.months.map((m) => ({
          label: monthShortName(m.month.year, m.month.month),
          created: m.created,
          resolved: m.resolved,
        }))}
        title="Tickets creados y resueltos por mes"
        idPrefix="monthly"
        note="El último mes está en curso."
      />
    </ChartCard>

    <section class="section" aria-labelledby="people-title">
      <div class="section-head">
        <h2 id="people-title">Reparto entre personas</h2>
        {report.averageLoad !== null && (
          <p>
            Promedio: {formatNumber(report.averageLoad)} tareas abiertas por persona. Se considera
            equilibrado estar a menos de {formatNumber(report.band)} del promedio (±
            {tolerancePercent} %, y nunca menos de 1 tarea). La línea vertical de cada barra marca
            el promedio.
          </p>
        )}
      </div>
      {report.averageLoad === null ? (
        <div class="card">
          <EmptyState
            icon="capacity"
            title="Todavía no hay personas con tareas abiertas"
            help="El reparto aparecerá cuando alguien del equipo tenga tareas abiertas."
          />
        </div>
      ) : (
        <>
          <ChartCard title="Carga abierta por persona">
            <LoadBars people={report.people} average={report.averageLoad} />
          </ChartCard>

          <div class="section-head">
            <h2>Detalle por persona</h2>
            <p>
              El análisis incluye solo a {report.people.length} personas del equipo. Todas aparecen
              aunque no tengan nada abierto, porque su capacidad libre también cuenta.
            </p>
          </div>
          <DataTable label="Detalle por persona">
            <div class="only-wide">
              <PersonTable rows={report.people} canSeeTasks={canSeeTasks} />
            </div>
            <div class="only-narrow">
              <PersonTable rows={phone.first} canSeeTasks={canSeeTasks} />
              {phone.more.length > 0 && (
                <details class="more-rows">
                  <summary>Ver más ({phone.more.length})</summary>
                  <PersonTable rows={phone.more} withHead={false} canSeeTasks={canSeeTasks} />
                </details>
              )}
            </div>
          </DataTable>
        </>
      )}
    </section>

    {report.outside.length > 0 && (
      <section class="section" aria-labelledby="outside-title">
        <div class="section-head">
          <h2 id="outside-title">Fuera del análisis</h2>
          <p>
            Personas de otros equipos con tareas abiertas en este proyecto. No cuentan en ninguna
            cifra de esta página, pero se muestran para que no quede nada oculto.
          </p>
        </div>
        <div class="card">
          <details class="more">
            <summary>
              {report.outside.length} personas, {formatNumber(outsideOpen)} tareas abiertas
            </summary>
            <ul class="plain-list">
              {report.outside.map((person) => (
                <li>
                  {person.name}: {formatNumber(person.open)}
                </li>
              ))}
            </ul>
          </details>
        </div>
      </section>
    )}
  </div>
</BaseLayout>
