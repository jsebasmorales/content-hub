---
import { getJiraApp } from '@infrastructure/container';
import { quarterLabel } from '@domain/jira/quarter';
import ChartCard from '../components/ChartCard.astro';
import ComplianceChart from '../components/ComplianceChart.astro';
import DataTable from '../components/DataTable.astro';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import QuarterTable from '../components/QuarterTable.astro';
import VolumeChart from '../components/VolumeChart.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { syncFlashFromQuery } from '../sync-messages';

const principal = Astro.locals.principal;
if (!principal) return new Response(null, { status: 404 });

const jira = await getJiraApp();
// Opening the page refreshes stale data in the background; it never waits for Jira.
await jira.requestSync.lazy();

const [status, result] = await Promise.all([
  jira.syncStatus.execute(),
  jira.quarterly.execute(principal.permissions),
]);
if (!result.ok) return new Response(null, { status: 404 });
const { quarters } = result.value;

/** "T3 26": short enough to sit under a bar. */
const shortLabel = (quarter: { year: number; quarter: number }): string =>
  `T${String(quarter.quarter)} ${String(quarter.year).slice(2)}`;
const current = quarters.find((entry) => entry.inProgress);
const newestFirst = [...quarters].reverse();
---

<BaseLayout
  title="Trimestre a trimestre"
  sync={{ status, flash: syncFlashFromQuery(Astro.url.searchParams) }}
>
  <div class="page">
    <PageHeader
      title="Trimestre a trimestre"
      lede="Las mismas cifras para cada uno de los últimos trimestres, para ver hacia dónde va el equipo."
    />

    {quarters.length === 0 ? (
      <div class="card">
        <EmptyState
          icon="trend"
          title="Todavía no hay datos de Jira"
          help="Aparecerán cuando termine la primera actualización."
        />
      </div>
    ) : (
      <>
        {current && (
          <p class="notice notice-info" role="status">
            <Icon name="info" />
            <span>
              {quarterLabel(current.quarter)} está en curso ({current.elapsedDays} días): sus cifras
              son parciales y no deben compararse con las de un trimestre terminado.
            </span>
          </p>
        )}

        <ChartCard
          title="Cumplimiento de SLA por trimestre"
          subtitle="Porcentaje de ciclos que cumplen la meta, por métrica."
        >
          <ComplianceChart
            items={quarters.map((entry) => ({
              label: `${shortLabel(entry.quarter)}${entry.inProgress ? '*' : ''}`,
              compliance: entry.sla,
            }))}
            title="Cumplimiento de SLA por trimestre"
            idPrefix="sla-quarterly"
          />
        </ChartCard>

        <ChartCard
          title="Creados y resueltos por trimestre"
          subtitle="Tickets que entran frente a tickets que se cierran."
        >
          <VolumeChart
            items={quarters.map((entry) => ({
              label: `${shortLabel(entry.quarter)}${entry.inProgress ? '*' : ''}`,
              created: entry.created,
              resolved: entry.resolved,
            }))}
            title="Tickets creados y resueltos por trimestre"
            idPrefix="volume-quarterly"
            note="* Trimestre en curso: cifra parcial."
          />
        </ChartCard>

        <section class="section" aria-labelledby="numbers-title">
          <div class="section-head">
            <h2 id="numbers-title">Las cifras</h2>
            <p>
              El tiempo típico es la mediana de días entre crear y resolver. Cada métrica de SLA
              debe llegar al 90 % por separado para cumplir la meta.
            </p>
          </div>
          <DataTable label="Cifras por trimestre">
            <QuarterTable rows={newestFirst} />
          </DataTable>
        </section>
      </>
    )}
  </div>
</BaseLayout>
