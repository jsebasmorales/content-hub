---
import { getApp } from '@infrastructure/container';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import StatusChip from '../components/StatusChip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { flashFromQuery } from '../admin-messages';
import type { IconName } from '../icons';
import type { StatusKind } from '../status-kind';

const principal = Astro.locals.principal;
if (!principal) return new Response(null, { status: 404 });

const app = await getApp();
const overview = await app.getAccessOverview.execute(principal);
if (!overview.ok) return new Response(null, { status: 404 });

const { users, roles } = overview.value;
const csrfToken = app.csrf.tokenFor(principal.sessionId);
const flash = flashFromQuery(Astro.url.searchParams);

/** The state of each person as a chip: an icon and a word, never color alone. */
const STATUS_CHIP: Record<
  'invitado' | 'activo' | 'desactivado',
  { label: string; kind: StatusKind; icon: IconName }
> = {
  invitado: { label: 'Invitado', kind: 'info', icon: 'mail' },
  activo: { label: 'Activo', kind: 'success', icon: 'check-circle' },
  desactivado: { label: 'Desactivado', kind: 'error', icon: 'block' },
};
---

<BaseLayout title="Permisos">
  <div class="page">
    <PageHeader
      title="Permisos"
      lede="Invita a personas del equipo y asigna su rol. Solo los Líderes ven esta página."
    />

    {flash && (
      <p class={`notice notice-${flash.kind}`} role={flash.kind === 'error' ? 'alert' : 'status'}>
        <Icon name={flash.kind === 'error' ? 'x-circle' : 'check-circle'} />
        <span>{flash.text}</span>
      </p>
    )}

    <section class="card" aria-labelledby="invite-title">
      <h2 id="invite-title">Invitar a una persona</h2>
      <form class="invite-form" method="post" action="/api/admin/users">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <input type="hidden" name="intent" value="invite" />
        <div class="field field-grow">
          <label for="invite-email">Correo de Holafly</label>
          <input
            id="invite-email"
            name="email"
            type="email"
            required
            maxlength="254"
            placeholder="nombre@holafly.com"
          />
        </div>
        <div class="field">
          <label for="invite-role">Rol</label>
          <select id="invite-role" name="roleId" required>
            {roles.map((role) => (
              <option value={role.id}>{role.name}</option>
            ))}
          </select>
        </div>
        <button class="btn" type="submit">
          <Icon name="mail" size={16} />
          Enviar invitación
        </button>
        <div class="field field-wide">
          <label class="check">
            <input type="checkbox" name="confirmLeader" value="yes" />
            Confirmo que, si elijo Líder, esta persona tendrá acceso total y podrá cambiar permisos.
          </label>
        </div>
      </form>
    </section>

    <section class="card table-card" aria-labelledby="people-title">
      <div class="table-head">
        <h2 id="people-title">Personas con acceso</h2>
        <p class="chart-total">
          {users.length === 1 ? '1 persona' : `${String(users.length)} personas`}
        </p>
      </div>
      <div class="table-scroll">
        <table class="data-table people-table">
          <thead>
            <tr>
              <th scope="col">Correo</th>
              <th scope="col">Estado</th>
              <th scope="col">Rol</th>
              <th scope="col">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {users.map((user) => (
              <tr>
                <td data-label="Correo">
                  <span class="person-cell">{user.email}</span>
                </td>
                <td data-label="Estado">
                  <StatusChip
                    kind={STATUS_CHIP[user.status].kind}
                    icon={STATUS_CHIP[user.status].icon}
                    label={STATUS_CHIP[user.status].label}
                  />
                </td>
                <td data-label="Rol">
                  <form class="inline-form" method="post" action="/api/admin/users">
                    <input type="hidden" name="_csrf" value={csrfToken} />
                    <input type="hidden" name="intent" value="role" />
                    <input type="hidden" name="userId" value={user.id} />
                    <label class="sr-only" for={`role-${user.id}`}>
                      Rol de {user.email}
                    </label>
                    <select id={`role-${user.id}`} name="roleId">
                      {roles.map((role) => (
                        <option value={role.id} selected={role.id === user.roleId}>
                          {role.name}
                        </option>
                      ))}
                    </select>
                    <label class="check">
                      <input type="checkbox" name="confirmLeader" value="yes" />
                      Confirmar Líder
                    </label>
                    <button class="btn btn-quiet btn-compact" type="submit">
                      Cambiar rol
                    </button>
                  </form>
                </td>
                <td data-label="Acciones">
                  <form class="inline-form" method="post" action="/api/admin/users">
                    <input type="hidden" name="_csrf" value={csrfToken} />
                    <input type="hidden" name="intent" value="status" />
                    <input type="hidden" name="userId" value={user.id} />
                    <input
                      type="hidden"
                      name="active"
                      value={user.status === 'desactivado' ? 'true' : 'false'}
                    />
                    <button
                      class={`btn btn-quiet btn-compact ${user.status === 'desactivado' ? '' : 'btn-danger'}`}
                      type="submit"
                    >
                      {user.status === 'desactivado' ? 'Reactivar' : 'Dar de baja'}
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
