---
import { getApp, getJiraApp } from '@infrastructure/container';
import { filterToParams } from '@domain/jira/global-filter';
import { SLA_METRICS } from '@domain/jira/sla';
import { TASKS_PER_PAGE } from '@domain/jira/task-list';
import BarList from '../components/BarList.astro';
import BreachTable from '../components/BreachTable.astro';
import ChartCard from '../components/ChartCard.astro';
import DataTable from '../components/DataTable.astro';
import EmptyState from '../components/EmptyState.astro';
import FilterBar from '../components/FilterBar.astro';
import GlobalFilters from '../components/GlobalFilters.astro';
import KpiCard from '../components/KpiCard.astro';
import PageHeader from '../components/PageHeader.astro';
import Pager from '../components/Pager.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BREACH_PARAMS, breachPageHref, parseBreachQuery } from '../breach-query';
import { otherParams } from '../filter-query';
import { clearFilterCookie, filterQuery, readFilterRequest, settleFilter } from '../filter-request';
import { formatNumber } from '../format-number';
import { describeWindow } from '../period-labels';
import { splitForPhone } from '../phone-split';
import { METRIC_LABEL } from '../sla-labels';
import { syncFlashFromQuery } from '../sync-messages';

const principal = Astro.locals.principal;
if (!principal) return new Response(null, { status: 404 });

const secure = (await getApp()).settings.secureCookies;
const request = readFilterRequest(Astro.url, Astro.cookies, secure);
if (request.reset) {
  clearFilterCookie(Astro.cookies, secure);
  return Astro.redirect(Astro.url.pathname, 303);
}

const jira = await getJiraApp();
// Opening the page refreshes stale data in the background; it never waits for Jira.
await jira.requestSync.lazy();

const [status, result] = await Promise.all([
  jira.syncStatus.execute(),
  jira.slaBreaches.execute(
    principal.permissions,
    parseBreachQuery(Astro.url.searchParams, request.raw),
  ),
]);
if (!result.ok) return new Response(null, { status: 404 });
const { panel, summary, options, filter, rows } = result.value;

const tidy = settleFilter(Astro.url, Astro.cookies, secure, request, panel.filter);
if (tidy) return Astro.redirect(tidy, 303);

const timeZone = principal.user.timeZone;

const periodLabel = describeWindow(panel.filter.window);
const filtered = filter.metric !== null || filter.assigneeId !== null;
const from = rows.total === 0 ? 0 : (rows.page - 1) * TASKS_PER_PAGE + 1;
const to = rows.total === 0 ? 0 : from + rows.items.length - 1;
const phone = splitForPhone(rows.items);
// The list's own filters travel next to the global ones; the global filter is what the list form keeps.
const globalParams = filterToParams(panel.filter);
const listParams = otherParams(Astro.url.searchParams, [BREACH_PARAMS.page, 'sync']);
---

<BaseLayout
  title="SLAs incumplidos"
  sync={{ status, flash: syncFlashFromQuery(Astro.url.searchParams) }}
  filterQuery={filterQuery(panel.filter)}
>
  <div class="page">
    <PageHeader
      title="SLAs incumplidos"
      lede="Cada ciclo que no llegó a su meta en el período, del mayor retraso al menor. Suma los mismos ciclos que cuenta el cumplimiento de la página de SLAs."
    />

    <GlobalFilters action="/incumplimientos" panel={panel} carry={listParams} />

    <section class="section" aria-labelledby="summary-title">
      <div class="section-head">
        <h2 id="summary-title">Resumen de {periodLabel}</h2>
      </div>
      <div class="kpi-grid kpi-grid-3">
        <KpiCard
          label="Incumplimientos"
          value={formatNumber(summary.total)}
          tip="Ciclos de SLA que no llegaron a su meta: los terminados fuera de plazo y los que siguen corriendo ya pasados de su límite."
        />
        {SLA_METRICS.map((metric) => (
          <KpiCard
            label={METRIC_LABEL[metric]}
            value={formatNumber(summary.byMetric[metric])}
            tip="Incumplimientos de esta métrica en el período."
          />
        ))}
      </div>
    </section>

    {summary.total > 0 && (
      <div class="two-up">
        <ChartCard title="Quién acumula más">
          <BarList items={summary.byAssignee} />
        </ChartCard>
        <ChartCard title="Qué tipo de solicitud">
          <BarList items={summary.byRequestType} />
        </ChartCard>
      </div>
    )}

    <section class="section" aria-labelledby="list-title">
      <div class="section-head">
        <h2 id="list-title">Lista</h2>
      </div>
      <FilterBar
        action="/incumplimientos"
        label="Filtros de la lista"
        hidden={globalParams}
        clearHref={filtered ? breachPageHref(new URLSearchParams(globalParams), 1) : undefined}
      >
        <div class="field">
          <label for="b-metrica">Métrica</label>
          <select id="b-metrica" name={BREACH_PARAMS.metric}>
            <option value="">Todas</option>
            {options.metrics.map((option) => (
              <option value={option.value} selected={option.value === filter.metric}>
                {METRIC_LABEL[option.value as 'first_response' | 'done']} (
                {formatNumber(option.count)})
              </option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="b-asignado">Asignado a</label>
          <select id="b-asignado" name={BREACH_PARAMS.assigneeId}>
            <option value="">Todos</option>
            {options.assignees.map((option) => (
              <option value={option.value} selected={option.value === filter.assigneeId}>
                {option.label} ({formatNumber(option.count)})
              </option>
            ))}
          </select>
        </div>
      </FilterBar>

      {rows.total > 0 && (
        <p class="list-status" role="status">
          {`Mostrando ${formatNumber(from)}–${formatNumber(to)} de ${formatNumber(rows.total)} incumplimientos${filtered ? ' (con filtros)' : ''}.`}
        </p>
      )}

      {rows.items.length > 0 ? (
        <DataTable label="Incumplimientos">
          <div class="only-wide">
            <BreachTable rows={rows.items} ticketUrlOf={jira.ticketUrl} timeZone={timeZone} />
          </div>
          <div class="only-narrow">
            <BreachTable rows={phone.first} ticketUrlOf={jira.ticketUrl} timeZone={timeZone} />
            {phone.more.length > 0 && (
              <details class="more-rows">
                <summary>Ver más ({phone.more.length})</summary>
                <BreachTable
                  rows={phone.more}
                  ticketUrlOf={jira.ticketUrl}
                  timeZone={timeZone}
                  withHead={false}
                />
              </details>
            )}
          </div>
        </DataTable>
      ) : (
        <div class="card" role="status">
          <EmptyState
            icon={summary.total === 0 ? 'check-circle' : 'breach'}
            title={
              summary.total === 0
                ? 'No hubo incumplimientos en este período'
                : 'Ningún incumplimiento cumple esos filtros'
            }
            help={
              summary.total === 0
                ? 'Todos los ciclos medidos llegaron a su meta.'
                : 'Prueba con otra métrica u otra persona.'
            }
          />
        </div>
      )}

      {rows.pageCount > 1 && (
        <Pager
          page={rows.page}
          pageCount={rows.pageCount}
          prevHref={rows.page > 1 ? breachPageHref(Astro.url.searchParams, rows.page - 1) : null}
          nextHref={
            rows.page < rows.pageCount
              ? breachPageHref(Astro.url.searchParams, rows.page + 1)
              : null
          }
        />
      )}
    </section>
  </div>
</BaseLayout>
