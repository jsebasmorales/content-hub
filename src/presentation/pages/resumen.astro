---
import { getApp, getJiraApp } from '@infrastructure/container';
import BarList from '../components/BarList.astro';
import ChartCard from '../components/ChartCard.astro';
import DataTable from '../components/DataTable.astro';
import EmptyState from '../components/EmptyState.astro';
import GlobalFilters from '../components/GlobalFilters.astro';
import KpiCard from '../components/KpiCard.astro';
import PageHeader from '../components/PageHeader.astro';
import SummaryTypeTable from '../components/SummaryTypeTable.astro';
import VolumeChart from '../components/VolumeChart.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { clearFilterCookie, filterQuery, readFilterRequest, settleFilter } from '../filter-request';
import { formatNumber, formatPercent } from '../format-number';
import { bucketLabel, describeWindow, granularityNoun } from '../period-labels';
import { syncFlashFromQuery } from '../sync-messages';

const principal = Astro.locals.principal;
if (!principal) return new Response(null, { status: 404 });

const secure = (await getApp()).settings.secureCookies;
const request = readFilterRequest(Astro.url, Astro.cookies, secure);
if (request.reset) {
  clearFilterCookie(Astro.cookies, secure);
  return Astro.redirect(Astro.url.pathname, 303);
}

const jira = await getJiraApp();
// Opening the page refreshes stale data in the background; it never waits for Jira.
await jira.requestSync.lazy();

const [status, result] = await Promise.all([
  jira.syncStatus.execute(),
  jira.summary.execute(principal.permissions, request.raw),
]);
if (!result.ok) return new Response(null, { status: 404 });
const { panel, report, granularity } = result.value;

const tidy = settleFilter(Astro.url, Astro.cookies, secure, request, panel.filter);
if (tidy) return Astro.redirect(tidy, 303);

const { window, types } = panel.filter;
const periodLabel = describeWindow(window);
const sentence = periodLabel.charAt(0).toUpperCase() + periodLabel.slice(1);
const heading = types.all ? sentence : `${sentence} · ${types.names.join(', ')}`;
const statusRows = report.openNow.byStatus.map((row) => ({
  label: row.status,
  count: row.count,
}));
---

<BaseLayout
  title="Resumen"
  sync={{ status, flash: syncFlashFromQuery(Astro.url.searchParams) }}
  filterQuery={filterQuery(panel.filter)}
>
  <div class="page">
    <PageHeader
      title="Resumen"
      lede="La vista base de los tickets: cuántos se crean, cuántos se completan y cuántos siguen en curso. Se alimenta solo de Jira."
    />

    <GlobalFilters action="/resumen" panel={panel} />

    <section class="section" aria-labelledby="kpi-title">
      <div class="section-head">
        <h2 id="kpi-title">{heading}</h2>
      </div>
      <div class="kpi-grid kpi-grid-3">
        <KpiCard
          label="Creados"
          value={formatNumber(report.created)}
          tip="Tickets nuevos del período, según su fecha de creación en hora de Bogotá."
        />
        <KpiCard
          label="Completados en el período"
          value={formatNumber(report.resolved)}
          tip="Tickets que pasaron a Hecho dentro del período, sin importar cuándo se crearon. Incluye trabajo creado antes, por eso puede ser mayor que Creados."
        />
        <KpiCard
          label="% de lo creado ya completado"
          value={formatPercent(report.completionPercent)}
          tip="Solo mira lo creado en el período: cuántos de esos tickets ya están completados hoy. No cuenta lo creado antes, aunque se haya completado en el período. En un período reciente es menor porque hubo menos tiempo para completarse."
        />
        <KpiCard
          label="Tiempo típico (días)"
          value={report.resolutionDays === null ? 'Sin datos' : formatNumber(report.resolutionDays)}
          tip="Mediana de días naturales entre crear y completar, de los tickets completados en el período."
        />
        <KpiCard
          label="En curso hoy"
          value={formatNumber(report.openNow.inProgress)}
          tip="Tickets abiertos que Jira agrupa como en curso: alguien trabaja en ellos o esperan algo (aprobación, traducción…). Es el estado de hoy, no del período."
        />
        <KpiCard
          label="Sin empezar hoy"
          value={formatNumber(report.openNow.notStarted)}
          tip="Tickets abiertos que nadie ha empezado todavía. Es el estado de hoy, no del período."
        />
      </div>
    </section>

    <ChartCard title={`Creados y completados, ${granularityNoun(granularity)}`}>
      {report.flow.length === 0 ? (
        <EmptyState
          icon="info"
          title="Sin actividad en este período"
          help="No hubo tickets creados ni completados en este período."
        />
      ) : (
        <VolumeChart
          items={report.flow.map((point) => ({
            label: bucketLabel(point.bucket, granularity),
            created: point.created,
            resolved: point.resolved,
          }))}
          title={`Tickets creados y completados ${granularityNoun(granularity)}`}
          idPrefix="summary-monthly"
          resolvedLabel="Completados"
          note="La última barra llega hasta hoy."
        />
      )}
    </ChartCard>

    {report.byType.length > 0 && (
      <section class="section" aria-labelledby="by-type-title">
        <div class="section-head">
          <h2 id="by-type-title">Por tipo de solicitud</h2>
          <p>De más a menos creados. "Abiertos hoy" es el estado de hoy, no del período.</p>
        </div>
        <DataTable
          label="Tickets por tipo de solicitud"
          footnote="Los tipos obsoletos no aparecen en la tabla, pero sí en los totales."
        >
          <SummaryTypeTable rows={report.byType} />
        </DataTable>
      </section>
    )}

    <ChartCard title="Abiertos hoy por estado">
      <BarList items={statusRows} limit={10} empty="No hay tickets abiertos." />
    </ChartCard>
  </div>
</BaseLayout>
