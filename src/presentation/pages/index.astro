---
import { getJiraApp } from '@infrastructure/container';
import { quarterLabel } from '@domain/jira/quarter';
import BarList from '../components/BarList.astro';
import ChartCard from '../components/ChartCard.astro';
import Icon from '../components/Icon.astro';
import KpiCard from '../components/KpiCard.astro';
import PageHeader from '../components/PageHeader.astro';
import SlaCard from '../components/SlaCard.astro';
import VolumeChart from '../components/VolumeChart.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describeDelta, formatNumber, monthShortName } from '../format-number';
import { buildMenu, nextMenuItem } from '../navigation';
import { METRIC_LABEL, METRIC_TIP } from '../sla-labels';
import { syncFlashFromQuery } from '../sync-messages';

const principal = Astro.locals.principal;
if (!principal) return new Response(null, { status: 404 });

const jira = await getJiraApp();
// Opening the dashboard refreshes stale data in the background; the page never waits for Jira.
await jira.requestSync.lazy();

const [status, result] = await Promise.all([
  jira.syncStatus.execute(),
  jira.executiveSummary.execute(principal.permissions),
]);
if (!result.ok) return new Response(null, { status: 404 });
const summary = result.value;

const displayName = principal.user.name ?? principal.user.email;

const now = quarterLabel(summary.quarter);
const before = quarterLabel(summary.previousQuarter);
// Volumes are compared with the same stretch of the previous quarter, and the page says so.
const sameStretch = `${before} (mismos ${String(summary.elapsedDays)} días)`;
const goalText = {
  true: 'Las dos métricas de SLA cumplen la meta del trimestre.',
  false: 'Alguna métrica de SLA no llega a la meta del trimestre.',
  null: 'Todavía no hay datos suficientes para valorar la meta de SLA.',
} as const;

// Links only to what this person may open: a link to a hidden page would reveal that it exists.
const canSeeDefinitions = principal.permissions.has('section.defs');
const canSeeSlaPage = principal.permissions.has('section.sla');
const next = nextMenuItem(buildMenu(principal.permissions), '/');
const requestTotal = summary.requestTypes.reduce((sum, item) => sum + item.count, 0);
---

<BaseLayout
  title="Resumen ejecutivo"
  sync={{ status, flash: syncFlashFromQuery(Astro.url.searchParams) }}
>
  <div class="page">
    <PageHeader
      title="Resumen ejecutivo"
      lede={`Hola, ${displayName}. Trabajo de Contenido en ${now}, frente a ${before}.`}
    >
      {canSeeDefinitions && (
        <a class="btn btn-secondary btn-compact" href="/definiciones">
          <Icon name="help" size={16} />
          Cómo se calcula
        </a>
      )}
    </PageHeader>

    <section class="section" aria-labelledby="sla-title">
      <div class="section-head">
        <h2 id="sla-title">Cumplimiento de SLA en {now}</h2>
        <p>{goalText[String(summary.sla.goalMet) as 'true' | 'false' | 'null']}</p>
      </div>
      <div class="kpi-grid kpi-grid-2">
        {summary.sla.metrics.map((metric) => (
          <SlaCard
            metric={metric}
            label={METRIC_LABEL[metric.metric]}
            tip={METRIC_TIP[metric.metric]}
          />
        ))}
      </div>
      {canSeeSlaPage && (
        <p class="section-link">
          <a href="/sla">
            Ver el detalle de SLAs
            <Icon name="arrow-right" size={16} />
          </a>
        </p>
      )}
    </section>

    <section class="section" aria-labelledby="activity-title">
      <div class="section-head">
        <h2 id="activity-title">Actividad en {now}</h2>
        <p>
          Se compara con el mismo tramo del trimestre anterior: los primeros {summary.elapsedDays}{' '}
          días de {before}.
        </p>
      </div>
      <div class="kpi-grid kpi-grid-4">
        <KpiCard
          label="Tickets creados"
          value={formatNumber(summary.created.current ?? 0)}
          delta={describeDelta(
            summary.created.current,
            summary.created.previous,
            sameStretch,
            'neutral',
          )}
          tip="Solicitudes nuevas recibidas en el trimestre, según la fecha de creación en hora de Bogotá."
        />
        <KpiCard
          label="Tickets resueltos"
          value={formatNumber(summary.resolved.current ?? 0)}
          delta={describeDelta(
            summary.resolved.current,
            summary.resolved.previous,
            sameStretch,
            'better',
          )}
          tip="Solicitudes que pasaron a Hecho dentro del trimestre, sin importar cuándo se crearon."
        />
        <KpiCard
          label="Abiertos hoy"
          value={formatNumber(summary.openNow)}
          change="Estado de hoy"
          tip="Solicitudes que todavía no están en Hecho, sea cual sea su antigüedad."
        />
        <KpiCard
          label="Tiempo típico de resolución"
          value={
            summary.resolutionDays.current === null
              ? 'Sin datos'
              : `${formatNumber(summary.resolutionDays.current)} días`
          }
          delta={describeDelta(
            summary.resolutionDays.current,
            summary.resolutionDays.previous,
            sameStretch,
            'worse',
            ' días',
          )}
          tip="Mediana de días naturales entre crear y resolver, de las solicitudes resueltas en el trimestre. Se usa la mediana para que unas pocas solicitudes muy antiguas no distorsionen la cifra."
        />
      </div>
    </section>

    <ChartCard title="Creados y resueltos, últimos 6 meses">
      <VolumeChart
        items={summary.months.map((m) => ({
          label: monthShortName(m.month.year, m.month.month),
          created: m.created,
          resolved: m.resolved,
        }))}
        title="Tickets creados y resueltos por mes"
        idPrefix="monthly"
        note="El último mes está en curso."
      />
    </ChartCard>

    <ChartCard
      title={`Qué se pidió en ${now}`}
      total={`Total: ${formatNumber(requestTotal)} tickets`}
    >
      <BarList
        items={summary.requestTypes.map((item) => ({ label: item.requestType, count: item.count }))}
      />
    </ChartCard>

    {next && (
      <nav class="next-link" aria-label="Página siguiente">
        <a href={next.href}>
          <span class="next-link-text">
            <span class="next-link-kicker">Siguiente</span>
            <span class="next-link-title">{next.label}</span>
          </span>
          <Icon name="arrow-right" />
        </a>
      </nav>
    )}
  </div>
</BaseLayout>
