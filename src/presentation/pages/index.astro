---
import { getApp, getJiraApp } from '@infrastructure/container';
import BarList from '../components/BarList.astro';
import ChartCard from '../components/ChartCard.astro';
import GlobalFilters from '../components/GlobalFilters.astro';
import Icon from '../components/Icon.astro';
import KpiCard from '../components/KpiCard.astro';
import PageHeader from '../components/PageHeader.astro';
import SlaCard from '../components/SlaCard.astro';
import VolumeChart from '../components/VolumeChart.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { clearFilterCookie, filterQuery, readFilterRequest, settleFilter } from '../filter-request';
import { describeComparedDelta, formatNumber } from '../format-number';
import { buildMenu, nextMenuItem } from '../navigation';
import { bucketLabel, describeDays, describeWindow, granularityNoun } from '../period-labels';
import { METRIC_LABEL, METRIC_TIP } from '../sla-labels';
import { syncFlashFromQuery } from '../sync-messages';

const principal = Astro.locals.principal;
if (!principal) return new Response(null, { status: 404 });

const secure = (await getApp()).settings.secureCookies;
const request = readFilterRequest(Astro.url, Astro.cookies, secure);
if (request.reset) {
  clearFilterCookie(Astro.cookies, secure);
  return Astro.redirect(Astro.url.pathname, 303);
}

const jira = await getJiraApp();
// Opening the dashboard refreshes stale data in the background; the page never waits for Jira.
await jira.requestSync.lazy();

const [status, result] = await Promise.all([
  jira.syncStatus.execute(),
  jira.executiveSummary.execute(principal.permissions, request.raw),
]);
if (!result.ok) return new Response(null, { status: 404 });
const { summary, panel, previous, granularity } = result.value;

const tidy = settleFilter(Astro.url, Astro.cookies, secure, request, panel.filter);
if (tidy) return Astro.redirect(tidy, 303);

const displayName = principal.user.name ?? principal.user.email;
const { window } = panel.filter;
const now = describeWindow(window);
const before = describeDays(previous);
const reference = 'período anterior';
const goalText = {
  true: 'Las dos métricas de SLA cumplen la meta en este período.',
  false: 'Alguna métrica de SLA no llega a la meta en este período.',
  null: 'Todavía no hay datos suficientes para valorar la meta de SLA.',
} as const;

// Links only to what this person may open: a link to a hidden page would reveal that it exists.
const canSeeDefinitions = principal.permissions.has('section.defs');
const canSeeSlaPage = principal.permissions.has('section.sla');
const query = filterQuery(panel.filter);
const next = nextMenuItem(buildMenu(principal.permissions), '/');
const requestTotal = summary.requestTypes.reduce((sum, item) => sum + item.count, 0);
---

<BaseLayout
  title="Resumen ejecutivo"
  sync={{ status, flash: syncFlashFromQuery(Astro.url.searchParams) }}
  filterQuery={query}
>
  <div class="page">
    <PageHeader
      title="Resumen ejecutivo"
      lede={`Hola, ${displayName}. Trabajo de Contenido en ${now}, frente al período anterior de ${String(summary.days)} días.`}
    >
      {canSeeDefinitions && (
        <a class="btn btn-secondary btn-compact" href="/definiciones">
          <Icon name="help" size={16} />
          Cómo se calcula
        </a>
      )}
    </PageHeader>

    <GlobalFilters action="/" panel={panel} />

    <section class="section" aria-labelledby="sla-title">
      <div class="section-head">
        <h2 id="sla-title">Cumplimiento de SLA en {now}</h2>
        <p>{goalText[String(summary.sla.goalMet) as 'true' | 'false' | 'null']}</p>
      </div>
      <div class="kpi-grid kpi-grid-2">
        {summary.sla.metrics.map((metric) => (
          <SlaCard
            metric={metric}
            label={METRIC_LABEL[metric.metric]}
            tip={METRIC_TIP[metric.metric]}
          />
        ))}
      </div>
      {canSeeSlaPage && (
        <p class="section-link">
          <a href={`/sla${query}`}>
            Ver el detalle de SLAs
            <Icon name="arrow-right" size={16} />
          </a>
        </p>
      )}
    </section>

    <section class="section" aria-labelledby="activity-title">
      <div class="section-head">
        <h2 id="activity-title">Actividad en {now}</h2>
        <p>
          Se compara con los {summary.days} días del período anterior: {before}.
        </p>
      </div>
      <div class="kpi-grid kpi-grid-4">
        <KpiCard
          label="Tickets creados"
          value={formatNumber(summary.created.current ?? 0)}
          delta={describeComparedDelta({
            ...summary.created,
            kind: 'count',
            higherIs: 'neutral',
            reference,
          })}
          tip="Solicitudes nuevas recibidas en el período, según la fecha de creación en hora de Bogotá."
        />
        <KpiCard
          label="Tickets resueltos"
          value={formatNumber(summary.resolved.current ?? 0)}
          delta={describeComparedDelta({
            ...summary.resolved,
            kind: 'count',
            higherIs: 'better',
            reference,
          })}
          tip="Solicitudes que pasaron a Hecho dentro del período, sin importar cuándo se crearon."
        />
        <KpiCard
          label="Abiertos hoy"
          value={formatNumber(summary.openNow)}
          change="Estado de hoy"
          tip="Solicitudes que todavía no están en Hecho, sea cual sea su antigüedad. No depende del período."
        />
        <KpiCard
          label="Tiempo típico de resolución"
          value={
            summary.resolutionDays.current === null
              ? 'Sin datos'
              : `${formatNumber(summary.resolutionDays.current)} días`
          }
          delta={describeComparedDelta({
            ...summary.resolutionDays,
            kind: 'days',
            higherIs: 'worse',
            reference,
          })}
          tip="Mediana de días naturales entre crear y resolver, de las solicitudes resueltas en el período. Se usa la mediana para que unas pocas solicitudes muy antiguas no distorsionen la cifra."
        />
      </div>
    </section>

    <ChartCard title={`Creados y resueltos, ${granularityNoun(granularity)}`}>
      <VolumeChart
        items={summary.flow.map((point) => ({
          label: bucketLabel(point.bucket, granularity),
          created: point.created,
          resolved: point.resolved,
        }))}
        title={`Tickets creados y resueltos ${granularityNoun(granularity)}`}
        idPrefix="monthly"
        note="La última barra llega hasta hoy."
      />
    </ChartCard>

    <ChartCard
      title={`Qué se pidió en ${now}`}
      total={`Total: ${formatNumber(requestTotal)} tickets`}
    >
      <BarList
        items={summary.requestTypes.map((item) => ({ label: item.requestType, count: item.count }))}
        empty="Todavía no hay tickets creados en este período."
      />
    </ChartCard>

    {next && (
      <nav class="next-link" aria-label="Página siguiente">
        <a href={next.globalFilter ? `${next.href}${query}` : next.href}>
          <span class="next-link-text">
            <span class="next-link-kicker">Siguiente</span>
            <span class="next-link-title">{next.label}</span>
          </span>
          <Icon name="arrow-right" />
        </a>
      </nav>
    )}
  </div>
</BaseLayout>
