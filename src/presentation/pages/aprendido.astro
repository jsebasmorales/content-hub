---
import { getApp, getLearnedApp } from '@infrastructure/container';
import { quarterLabel } from '@domain/jira/quarter';
import { quarterParam } from '@domain/jira/report-period';
import { LEARNED_FIELD_MAX } from '@domain/learned/learned';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatMoment } from '../format-moment';
import { learnedFlashFromQuery } from '../learned-messages';
import { PHONE_ROWS } from '../phone-split';

const principal = Astro.locals.principal;
if (!principal) return new Response(null, { status: 404 });

const learned = await getLearnedApp();
const result = await learned.getLearned.execute(
  principal.permissions,
  Astro.url.searchParams.get('trimestre'),
);
if (!result.ok) return new Response(null, { status: 404 });
const page = result.value;

const csrfToken = (await getApp()).csrf.tokenFor(principal.sessionId);
const timeZone = principal.user.timeZone;
const canEdit = principal.permissions.has('action.learnedit');
const flash = learnedFlashFromQuery(Astro.url.searchParams);
const current = quarterParam(page.quarter);
const label = quarterLabel(page.quarter);

const boxes = [
  {
    id: 'conclusions',
    title: 'Conclusiones del trimestre',
    help: 'Qué aprendimos: lo que los números no dicen por sí solos.',
    value: page.latest?.conclusions ?? '',
  },
  {
    id: 'nextFocus',
    title: 'Foco del siguiente trimestre',
    help: 'Las prioridades en las que se concentra el equipo (el "foco del Q").',
    value: page.latest?.nextFocus ?? '',
  },
  {
    id: 'notes',
    title: 'Notas',
    help: 'Cualquier otra cosa que convenga recordar.',
    value: page.latest?.notes ?? '',
  },
] as const;

const olderVersions = page.history.slice(1);
const shownVersions = olderVersions.slice(0, PHONE_ROWS);
const moreVersions = olderVersions.slice(PHONE_ROWS);
---

<BaseLayout title="Lo aprendido">
  <div class="page">
    <PageHeader
      title="Lo aprendido"
      lede="Las conclusiones de cada trimestre y el foco del siguiente: la interpretación humana de lo que dicen los números. Lo escribe el Líder."
    />

    {flash && (
      <p class={`notice notice-${flash.kind}`} role={flash.kind === 'error' ? 'alert' : 'status'}>
        <Icon name={flash.kind === 'error' ? 'x-circle' : 'check-circle'} />
        <span>{flash.text}</span>
      </p>
    )}
    {page.ignoredQuarter && (
      <p class="notice notice-error" role="alert">
        <Icon name="x-circle" />
        <span>No pudimos usar el trimestre pedido, así que se muestra el actual.</span>
      </p>
    )}

    <section class="section" aria-label="Trimestre">
      <nav class="quick-quarters" aria-label="Trimestres">
        {page.quarters.map((entry) => {
          const param = quarterParam(entry.quarter);
          return (
            <a
              class={`chip ${param === current ? 'chip-on' : ''}`}
              href={`/aprendido?trimestre=${param}`}
              aria-current={param === current ? 'page' : undefined}
            >
              {quarterLabel(entry.quarter)}
              {entry.written && (
                <>
                  <Icon name="edit" size={16} class="chip-mark" />
                  <span class="chip-note">con texto</span>
                </>
              )}
            </a>
          );
        })}
      </nav>
      <p class="list-status">El lápiz marca los trimestres que ya tienen texto guardado.</p>
    </section>

    <section class="section" aria-labelledby="quarter-title">
      <div class="section-head">
        <h2 id="quarter-title">{label}</h2>
        <p>
          {page.latest
            ? `Última versión: ${formatMoment(page.latest.createdAt, timeZone)}, por ${page.latest.authorName}.`
            : 'Todavía no hay nada escrito para este trimestre.'}
        </p>
      </div>

      {canEdit ? (
        <form class="learned-form" method="post" action="/api/learned">
          <input type="hidden" name="_csrf" value={csrfToken} />
          <input type="hidden" name="trimestre" value={current} />
          {boxes.map((box) => (
            <div class="card learned-box">
              <label for={`l-${box.id}`}>{box.title}</label>
              <p class="field-help" id={`l-${box.id}-help`}>
                {box.help}
              </p>
              <textarea
                id={`l-${box.id}`}
                name={box.id}
                rows="7"
                maxlength={LEARNED_FIELD_MAX}
                aria-describedby={`l-${box.id}-help`}
              >{box.value}</textarea>
            </div>
          ))}
          <div class="learned-actions">
            <button class="btn" type="submit">
              Guardar nueva versión
            </button>
            <p class="list-status">
              Cada guardado crea una versión nueva con tu nombre y la fecha. Las anteriores se
              conservan y se pueden ver abajo.
            </p>
          </div>
        </form>
      ) : (
        <section class="card">
          {boxes.map((box) => (
            <div class="learned-read">
              <h3>{box.title}</h3>
              <p class="learned-text">{box.value === '' ? 'Sin texto.' : box.value}</p>
            </div>
          ))}
        </section>
      )}
    </section>

    {olderVersions.length > 0 && (
      <section class="section" aria-labelledby="versions-title">
        <div class="section-head">
          <h2 id="versions-title">Versiones anteriores</h2>
          <p>De la más reciente a la más antigua. La que ves arriba es la última.</p>
        </div>
        <div class="card versions">
          {shownVersions.map((version) => (
            <details class="version">
              <summary>
                <span>
                  {formatMoment(version.createdAt, timeZone)} · {version.authorName}
                </span>
                <Icon name="chevron-down" size={16} />
              </summary>
              {boxes.map((box) => (
                <div class="learned-read">
                  <h3>{box.title}</h3>
                  <p class="learned-text">
                    {version[box.id] === '' ? 'Sin texto.' : version[box.id]}
                  </p>
                </div>
              ))}
            </details>
          ))}
          {moreVersions.length > 0 && (
            <details class="more-rows">
              <summary>Ver más ({moreVersions.length})</summary>
              {moreVersions.map((version) => (
                <details class="version">
                  <summary>
                    <span>
                      {formatMoment(version.createdAt, timeZone)} · {version.authorName}
                    </span>
                    <Icon name="chevron-down" size={16} />
                  </summary>
                  {boxes.map((box) => (
                    <div class="learned-read">
                      <h3>{box.title}</h3>
                      <p class="learned-text">
                        {version[box.id] === '' ? 'Sin texto.' : version[box.id]}
                      </p>
                    </div>
                  ))}
                </details>
              ))}
            </details>
          )}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
