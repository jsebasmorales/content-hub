---
import { getApp } from '@infrastructure/container';
import AppSidebar from '../components/AppSidebar.astro';
import TopBar from '../components/TopBar.astro';
import { buildMenu } from '../navigation';
import { readTheme } from '../theme';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const principal = Astro.locals.principal;
const menu = principal ? buildMenu(principal.permissions) : [];
const csrfToken = principal ? (await getApp()).csrf.tokenFor(principal.sessionId) : '';
const pathname = Astro.url.pathname;
const theme = readTheme(Astro.cookies);
// The person's own choice, when they made one; otherwise the stylesheet follows the device.
const dataTheme = theme === 'system' ? undefined : theme;
---

<!doctype html>
<html lang="es" data-theme={dataTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Content Hub</title>
  </head>
  <body>
    {principal ? (
      <div class="app">
        <AppSidebar menu={menu} current={pathname} />
        <div class="main-col">
          <TopBar
            principal={principal}
            csrfToken={csrfToken}
            theme={theme}
            back={`${pathname}${Astro.url.search}`}
          />
          <main class="content">
            <slot />
          </main>
        </div>
      </div>
    ) : (
      <main class="content">
        <slot />
      </main>
    )}
  </body>
</html>
