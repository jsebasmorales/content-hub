# Copy to .env for local development. NEVER commit real values.
# Required variables make the app refuse to start when missing (SDD section 15).

# --- Required from Phase 0 ---
# Local dev uses embedded Postgres (PGlite). Production: Netlify DB connection string.
DATABASE_URL=pglite:.data/dev
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
ALLOWED_EMAIL_DOMAIN=holafly.com
# First Leader. Only effective while no Leader exists (SDD 10.2).
BOOTSTRAP_LEADER_EMAIL=lider@holafly.com
PUBLIC_APP_URL=http://localhost:4321
# "local" only works outside production. Use "atlassian" once the OAuth app exists.
AUTH_PROVIDER=local

# --- Atlassian OAuth 2.0 (required when AUTH_PROVIDER=atlassian) ---
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=

# --- Jira (Phase 1) ---
# Required since Phase 1. Use a read-only service account (SDD 6.1).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=JSMCO
# Optional: custom field ids when they differ from this tenant's (docs/jira-mapping.md).
# JIRA_FIELD_SLA_RESPONSE=customfield_10062
# JIRA_FIELD_SLA_DONE=customfield_10152

# --- Background sync (Phase 1) ---
# Shared by the app and the background function that syncs Jira. At least 32 random characters,
# different from SESSION_SECRET. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SYNC_TRIGGER_SECRET=

# --- Crowdin (Phase 4) ---
CROWDIN_TOKEN=
CROWDIN_PROJECT_IDS=19,55
CROWDIN_WEBHOOK_SECRET=

# --- Storage and ingestion (Phases 2-3) ---
BLOB_READ_WRITE_TOKEN=
INGEST_API_TOKEN=
